{
  "name": "quence-infra",
  "version": "0.4.0",
  "description": "Infrastructure control center: servers, SSH terminals and live monitoring",
  "author": "Marijanoo",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "lint": "eslint .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently --kill-others \"npm run dev\" \"wait-on tcp:3003 && npm run build:electron && electron . 3003\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder",
    "build:electron-win": "npm run build && npm run build:electron && electron-builder --win --publish never",
    "build:electron-mac": "npm run build && npm run build:electron && electron-builder --mac --publish never",
    "build:electron-linux": "npm run build && npm run build:electron && electron-builder --linux --publish never",
    "test": "tsc -p electron/tsconfig.json --outDir .test-out && INFRA_OUT=$PWD/.test-out node --test test/*.test.mjs"
  },
  "build": {
    "appId": "com.quence.infra",
    "productName": "QuenceInfra",
    "directories": { "output": "dist" },
    "files": ["dist-electron/**/*", "out/**/*", "package.json", "public/logo.png"],
    "mac": {
      "icon": "public/logo.png",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": {
      "icon": "public/logo.png",
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": { "oneClick": true, "createDesktopShortcut": true, "createStartMenuShortcut": true },
    "linux": {
      "icon": "public/logo.png",
      "category": "Development",
      "target": "AppImage",
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-serve": "^1.1.0",
    "lucide-react": "^0.564.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^1.7.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.0",
    "concurrently": "^9.2.1",
    "electron": "^34.5.8",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "^5.7.3",
    "wait-on": "^9.0.10"
  }
}
